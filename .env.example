# PostgreSQL database configuration (placeholder credentials)
POSTGRES_DB=multiagent
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
CX_POSTGRES_PASSWORD=change_me_cx_database

# SeaweedFS S3-compatible storage configuration (placeholder credentials)
SEAWEEDFS_S3_ENDPOINT=http://localhost:8333
SEAWEEDFS_S3_ACCESS_KEY=local_dev_access_key
SEAWEEDFS_S3_SECRET_KEY=change_me

# Airflow: dedicated metadata database (not the application database)
AIRFLOW_UID=50000
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_USER=airflow_user
AIRFLOW_POSTGRES_PASSWORD=change_me_airflow_database

# Airflow Web UI administrator (placeholder credentials)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_admin
AIRFLOW_ADMIN_EMAIL=airflow-admin@example.com

# Replace every secret placeholder before starting Airflow.
# Fernet requires a generated URL-safe base64 key encoding 32 random bytes.
# API and JWT secrets should be separate, cryptographically random values.
AIRFLOW_FERNET_KEY=replace_with_generated_fernet_key
AIRFLOW_API_SECRET_KEY=replace_with_random_api_secret
AIRFLOW_JWT_SECRET=replace_with_random_jwt_secret
